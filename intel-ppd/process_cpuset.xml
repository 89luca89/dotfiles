<?xml version="1.0"?>

<!--
  Per-process CPU affinity seed for intel_lpmd's UseProcessCPUSet
  overlay. Tailored to a Fedora + GNOME laptop:
    systemd + dbus-broker + firewalld + sssd
    PipeWire audio, GNOME Shell on Wayland, GDM, ibus
    NetworkManager, wpa_supplicant, avahi-daemon
    cups + cups-browsed (network printing over mDNS, kept enabled)
    intel_lpmd + power-profiles-daemon + tuned-ppd shim
    dnf / rpm / rpm-ostree / flatpak
    docker + podman
    tailscaled

  Classification tiers (low priority -> high):
    background       - no UI, no display: system services, daemons,
                       indexers. Pinned to L-cores only.
    utility          - non-interactive helper work above background.
    user_initiated   - user-launched workloads incl. GUI apps,
                       browsers, terminals, IDEs. Default GUI tier.
    user_interactive - focused-window owner. intel_lpmd promotes a
                       PID to this tier on focus change (via
                       LPM_SET_FOCUS_PID from a compositor helper)
                       and demotes on focus loss. Compositor +
                       display-server + session stack stays here
                       regardless of focus.
    realtime         - PipeWire / audio engines.

  Named groups in <Cores> resolve at runtime against the current
  intel_lpmd state's ActiveCPUs:
      ActivePcores = P-cores  intersect ActiveCPUs (0-5)
      ActiveEcores = E-cores  intersect ActiveCPUs (6-13)
      ActiveLcores = LP-cores intersect ActiveCPUs (14-15)
  On Arrow Lake-H in Balanced: state has ActiveCPUs=6-15, so
  ActivePcores is empty and Realtime / UserInteractive /
  UserInitiated collapse to E+L. In Performance (LPMD_OFF)
  ActiveCPUs=all-16, so P+E+L classes actually use P-cores.

  Process names below match /proc/<pid>/comm, TRUNCATED TO 15 chars.
  Entries never seen on this box are inert - no PID matches, no
  cpuset applied - so a few just-in-case entries are cheap.
-->

<ProcessCpusetConfig>

    <ClassDefaults>
        <Realtime>
            <Cores>ActivePcores,ActiveEcores,ActiveLcores</Cores>
        </Realtime>
        <UserInteractive>
            <Cores>ActivePcores,ActiveEcores,ActiveLcores</Cores>
        </UserInteractive>
        <UserInitiated>
            <Cores>ActivePcores,ActiveEcores,ActiveLcores</Cores>
        </UserInitiated>
        <Utility>
            <Cores>ActiveEcores,ActiveLcores</Cores>
        </Utility>
        <Background>
            <Cores>ActiveLcores</Cores>
        </Background>
    </ClassDefaults>

    <!--
      Catch-all for user-session PIDs whose comm doesn't match any
      <Process> below. Resets inherited restrictive masks from an
      ancestor (e.g. make/cc1 spawned by gnome-terminal, which is
      user_initiated -> P+E+L). System-slice PIDs are NEVER touched
      by <DefaultProcess>: they either match a <Process> below or
      are left alone.
    -->
    <DefaultProcess>
        <Classification>unclassified</Classification>
        <ActiveCores>ActivePcores,ActiveEcores,ActiveLcores</ActiveCores>
        <AffinityAllThreads>1</AffinityAllThreads>
    </DefaultProcess>

    <!-- ===================================================== -->
    <!-- =============== SYSTEMD CORE (background) =========== -->
    <!-- ===================================================== -->
    <!--
      PID 1 (comm="systemd") is intentionally NOT listed. Placing
      it in a cpuset cgroup makes it react to cgroup changes,
      causing a service-restart loop. The per-user systemd
      instance (also comm="systemd") is skipped for the same
      reason. Leave both unconstrained.
    -->
