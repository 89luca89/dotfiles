bind index,pager g noop
bind index gg first-entry
bind index G last-entry
bind pager gg top
bind pager G bottom
bind index,pager R group-reply
bind index V tag-entry
bind index,pager D delete-thread
bind index,pager U undelete-thread
bind index,pager \Cd half-down
bind index,pager \Cu half-up
bind index,pager \Cf next-page
bind index,pager \Cb previous-page
macro index,pager \Cr "<imap-fetch-mail><enter-command>echo 'Checked for new mail'<enter>"
bind pager j next-line
bind pager k previous-line
bind pager <up> previous-line
bind pager <down> next-line
macro index gi "<change-folder>=INBOX<enter>" "go to inbox"
macro index ga "<change-folder>=[Gmail]/All Mail<enter>" "go to all mail"
macro index gs "<change-folder>=[Gmail]/Sent Mail<enter>" "go to sent mail"
macro index gd "<change-folder>=[Gmail]/Drafts<enter>" "go to drafts"
uncolor *
color index bold default default ~U
color index color13 default ~F
color index color1 default "~((~f notifications@github.com ~B merged ~B 'into main') | (~B closed ~B 'as completed') | (~f notifications@github.com ~B 'closed #') | (~f notifications@github.com ~B 'approved this pull request'))"
color index color1 default "~(~C xen-devel@lists\\.xenproject\\.org !~C luca@edera\\.dev)"
color index color1 default "~((~f notifications@linear\\.app ~s unread) | ~f 'edera-rebase-app\\[bot\\]|dependabot\\[bot\\]')"
color index color1 default "~(~f notifications@linear\\.app ~s alerts)"
color index color1 default "~(~f gemini ~s notes:)"
color index color8 default ~D
color index_number color8 default
color index_date color8 default
color index_size color8 default
color index_author color4 default
color index_flags color13 default
color index_subject color2 default "~s '^\\[(PATCH|RFC)'"
color tree color8 default
color header color8 default "^(Date|To|Cc):"
color header color4 default "^From:"
color header bold default default "^Subject:"
color quoted color6 default
color quoted1 color4 default
color quoted2 color5 default
color signature color8 default
color markers color8 default
color status default default
color body color4 default "(https?|ftp)://[^ \t>)]+"
color body color13 default "^(Signed-off|Reviewed|Acked|Tested|Reported|Suggested|Co-developed)-by:.*"
color body color13 default "^(Fixes|Link|Closes):.*"
color body bold default default "^(> ?)*(diff --git|index [0-9a-f]+\\.\\.|--- |\\+\\+\\+ ).*"
color body color6 default "^(> ?)*@@ .*"
color body color2 default "^(> ?)*\\+([^+].*)?$"
color body color1 default "^(> ?)*-([^ -].*|  .*| \\*.*)?$"
set use_threads = threads
set sort = reverse-last-date
set sort_aux = date
set index_format = "%4C %Z %[%b %d %H:%M] %-15.15L (%<l?%4l&%4c>) %s"
set beep_new
set timeout = 60
set pager_index_lines = 10
set pager_stop = no
set pager_context = 3
set message_cache_dir = ~/.cache/neomutt/messages
set header_cache = ~/.cache/neomutt/headers
set alias_file = ~/.config/neomutt/aliases
auto_view text/html
alternative_order text/plain text/html
source "[ ! -f ~/.config/neomutt/secrets.gpg ] || gpg -dq ~/.config/neomutt/secrets.gpg |"
source "[ ! -f ~/.config/neomutt/aliases ] || cat ~/.config/neomutt/aliases |"
