PACKAGE_KEEP_WORK="
com.android.chrome
com.google.android.apps.maps
com.google.android.inputmethod.latin
com.google.android.configupdater
"

printf '%s\n' "$PACKAGE_KEEP" |
	sed -e '/^[[:space:]]*$/d' \
		-e 's/\./\\./g' \
		-e 's/\\\.\*$/\\..*/' \
		-e 's/^/^/' \
		-e 's/$/$/' > /tmp/keep_list

# Get recommended and advanced list from UAD, ensure degogole, and sort
wget -qnvc 'https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation/raw/refs/heads/main/resources/assets/uad_lists.json'

PACKAGE_REMOVE="$(cat uad_lists.json | jq -r 'to_entries[] | select(.value.removal == "Recommended" or .value.removal == "Advanced") | .key' | sort -u)"
PACKAGE_REMOVE="$PACKAGE_REMOVE $DEGOOGLE"
PACKAGE_REMOVE="$(echo "$PACKAGE_REMOVE" | sort -u)"
echo "$PACKAGE_REMOVE" > /tmp/remove_list

PACKAGE_REMOVE="$(grep -Evf /tmp/keep_list /tmp/remove_list)"

user=0
[ -n "$1" ] && user=$1

if [ "$1" = "all" ]; then
	users="$(adb shell pm list users | cut -d':' -f1 | cut -d'{' -f2 | tail -n+2)"
	for i in $users; do
		sh "${0}" "$i"
	done
	exit
fi

if [ "$user" -ne 0 ]; then
	echo "$PACKAGE_REMOVE" | sort -u > /tmp/remove_list
	echo "$PACKAGE_KEEP_WORK" | sort -u > /tmp/keep_work_list
	for pkg in $PACKAGE_KEEP_WORK; do
		adb shell pm install-existing --user 10 "$pkg" > /dev/null 2>&1
	done
	PACKAGE_REMOVE="$(comm -23 /tmp/remove_list /tmp/keep_work_list)"
fi

echo "########### Removing unwanted packages for user $user ..."
PACKAGE_LIST="$(adb shell pm list packages -e --user "${user}")"
for package in $PACKAGE_REMOVE; do
	if echo "$PACKAGE_LIST" | grep -Eq ":${package}\.|:${package}$"; then
		subpkges="$(echo "$PACKAGE_LIST" | grep ":${package}" | cut -d':' -f2-)"
		for subpkg in $subpkges; do
			echo "$subpkg selected from $package"
		done
	fi
done
printf "%s" "########### Do you want to proceed? [y/N] "
read -r response
response="${response:-"N"}"
if [ "$response" = "Y" ] || [ "$response" = "y" ]; then
	printf "%s" "########### Do you want to uninstall or disable? [u/D] "
	read -r response_uninstall
	response_uninstall="${response_uninstall:-"D"}"

	for package in $PACKAGE_REMOVE; do
		if echo "$PACKAGE_LIST" | grep -Eq ":${package}\.|:${package}$"; then
			subpkges="$(echo "$PACKAGE_LIST" | grep ":${package}" | cut -d':' -f2-)"
			for subpkg in $subpkges; do
				echo "disabling $subpkg for user $user"
				adb shell pm disable-user --user "$user" "${subpkg}" 2> /dev/null || echo "FAILED $subpkg"
				if [ "$response_uninstall" = "u" ] || [ "$response_uninstall" = "U" ]; then
					echo "uninstalling $package for user $user"
					adb shell pm uninstall --user "$user" "${package}"
				fi
			done
		fi
	done
fi
