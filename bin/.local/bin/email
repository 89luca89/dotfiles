#!/bin/sh

has() { tmux list-windows -F '#W' | grep -qx "$1"; }

if ! has work || ! has personal; then
	[ ! -f ~/.config/neomutt/secrets.gpg ] || gpg -dq ~/.config/neomutt/secrets.gpg > /dev/null
fi
has work || tmux new-window -db -t :1 -c ~ -n work 'neomutt -F ~/.config/neomutt/work'
has personal || tmux new-window -da -t work -c ~ -n personal neomutt \; split-window -dh -t personal -c ~ 'gh dash'
tmux select-window -t work
