#!/bin/sh

# Send snapd to the shadow realm
grep snap /proc/mounts | awk '{print $2}' | xargs -I{} sudo umount {} || :
sudo apt remove --purge --autoremove \
	apport* whoopsie \
	cloud-init* switcheroo-control* \
	snapd* ubuntu-pro* \
	gnome-software* \
	software-properties-* \
	update-manager* unattended-upgrades*
sudo apt autoremove --purge
sudo apt-mark hold snapd
rm -rf ~/snap
sudo rm -rf /snap
sudo rm -rf /var/snap
sudo rm -rf /var/lib/snapd

################# SYSTEMD-BOOT SETUP ##########################################
sudo apt install --autoremove --purge \
	systemd-boot systemd-ukify \
	dracut tpm2-tools \
	sbsigntool efibootmgr binutils mokutil
sudo apt remove --autoremove --purge --allow-remove-essential \
	grub2* shim*
sudo apt-mark hold grub2* shim*

echo "timeout 0
default $(cat /etc/machine-id)-*" | sudo tee /boot/efi/loader/loader.conf

# Enable UKIs
sudo tee /etc/kernel/install.conf << EOF
BOOT_ROOT=/boot/efi
layout=uki
uki_generator=ukify
initrd_generator=dracut
EOF

sudo bootctl install
for i in /usr/lib/modules/*; do
	version="$(basename "$i")"
	sudo kernel-install add "${version}" /boot/vmlinuz-"${version}"
done
sudo efibootmgr show | grep -Ei "shim|grub" |
	cut -d' ' -f1 | grep -Eo "[0-9]+" | xargs -I{} sudo efibootmgr -B -b {}
################# SYSTEMD-BOOT SETUP ##########################################

################# SECURE BOOT SETUP ###########################################
. /etc/os-release
repo="https://download.opensuse.org/repositories/home:/jloeser:/secureboot/xUbuntu_${VERSION_ID}"
if key=$(wget -qO- "${repo}/Release.key"); then
	printf '%s\n' "$key" | sudo tee /etc/apt/keyrings/sbctl.asc > /dev/null
	echo "deb [signed-by=/etc/apt/keyrings/sbctl.asc] ${repo}/ /" | sudo tee /etc/apt/sources.list.d/sbctl.list > /dev/null
	sudo apt update
	sudo apt install sbctl
else
	echo "No sbctl build for Ubuntu ${VERSION_ID} (${repo}), skipping it" >&2
fi
printf 'Input Selection: '
read -r _
if sudo sbctl status | grep -q 'sbctl is not installed'; then
	sudo sbctl create-keys
	sudo sbctl enroll-keys --microsoft --firmware-builtin
	sudo sbctl verify | grep ' not ' | cut -d' ' -f2 | xargs -I{} sudo sbctl sign -s {}
fi
sudo tee /etc/kernel/install.d/99-sbctl.install << EOF
#!/bin/sh
sbctl verify | grep ' not ' | cut -d' ' -f2 | xargs -I{} sbctl sign -s {}
EOF
sudo chmod +x /etc/kernel/install.d/99-sbctl.install
################# SECURE BOOT SETUP ###########################################

# Utility stuff
sudo apt update
sudo apt upgrade
sudo apt install --autoremove --purge \
	adb \
	apt-file \
	btop \
	crun \
	curl \
	docker-buildx \
	docker-compose-v2 \
	docker.io \
	fastboot \
	flatpak \
	foot \
	foot-terminfo \
	foot-themes \
	git \
	lm-sensors \
	mosh \
	openssh-server \
	podman \
	powertop \
	runc \
	systemd-zram-generator \
	tmux \
	vim
repo="https://pkgs.tailscale.com/stable/ubuntu"
if key=$(wget -qO- "${repo}/${VERSION_CODENAME}.gpg"); then
	printf '%s\n' "$key" | sudo tee /etc/apt/keyrings/tailscale.asc > /dev/null
	echo "deb [signed-by=/etc/apt/keyrings/tailscale.asc] ${repo} ${VERSION_CODENAME} main" | sudo tee /etc/apt/sources.list.d/tailscale.list > /dev/null
	sudo apt update
	sudo apt install tailscale
	tailscale status > /dev/null || sudo tailscale up
else
	echo "No Tailscale build for Ubuntu ${VERSION_CODENAME} (${repo}), skipping it" >&2
fi
sudo systemctl enable --now docker
sudo systemctl enable --now powertop
sudo usermod -aG docker "$USER"

# Firewall security
sudo ufw enable
sudo ufw default deny incoming
sudo ufw allow OpenSSH
sudo ufw allow mosh

# mosh-server otherwise waits forever for a client that's gone (Termux
# killed), keeping a stale tmux client attached; give up after a day
echo "SetEnv MOSH_SERVER_NETWORK_TMOUT=86400" | sudo tee /etc/ssh/sshd_config.d/50-mosh.conf > /dev/null
sudo systemctl reload ssh || :

# Fix swap setup
if [ -e /etc/systemd/zram-generator.conf.dpkg-old ]; then
	sudo mv /etc/systemd/zram-generator.conf.dpkg-old /etc/systemd/zram-generator.conf
fi
