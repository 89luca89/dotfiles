#!/bin/bash
# Using bash instead of posix sh, to use arrays

# -y don't ask anything
if [[ $1 == "-y" ]]; then
	G_SURE="y"
else
	G_SURE="n"
fi

read_bool_config() {
	question=$1
	default=$2
	expected=$3

	while true; do
		read -p "$question  [$default]: " result
		if [ -n "$result" ]; then
			if [ -n "$expected" ]; then
				if [[ $result =~ ^[yYnN]$ ]]; then
					break
				else
					echo >&2 "Please reply Y or N."
				fi
			fi
		elif [ -n "$default" ]; then
			result=$default
			break
		fi
	done
	echo "${result}"
}

clean_folder() {
	dir=$1
	if [[ ! $G_SURE =~ ^[yY]$ ]]; then
		SURE=$(read_bool_config "Delete $dir? Y/N" "N" "Y or N")
	else
		SURE=$G_SURE
	fi
	if [[ $SURE =~ ^[yY]$ ]]; then
		rm -rf "${dir}"
	fi
}

FILES=(
	"./.bash_history"
	"./.localrc"
	"./.fzf.bash"
	"./.histfile"
	"./.claude.json"
	"./.gitconfig-edera"
	"./.bash_logout"
	"./.profile"
	"./.viminfo"
	"./.zshrc"
)
pushd ~/ || exit 127
find . -maxdepth 1 -type f -empty -delete
# -print0 and mapfile: no name splits or globs, and the prompts below keep reading stdin
mapfile -d '' -t entries < <(find . -mindepth 1 -maxdepth 1 -type f -print0)
for dir in "${entries[@]}"; do
	if [[ ! " ${FILES[@]} " =~ " ${dir} " ]]; then
		clean_folder "$dir"
	fi
done
popd || exit 1

FOLDERS=(
	"./.cache"
	"./.claude"
	"./.config"
	"./.ctags.d"
	"./.docker"
	"./.gnupg"
	"./.kube"
	"./.local"
	"./.pi"
	"./.ssh"
	"./.var"
	"./.vim"
	"./Desktop"
	"./Documents"
	"./Downloads"
	"./Music"
	"./DCIM"
	"./Pictures"
	"./Projects"
	"./Syncthing"
	"./Videos"
	"./VirtualMachines"
	"./bin"
	"./dotfiles"
)
pushd ~/ || exit 127
find . -maxdepth 1 -type d -empty -delete
mapfile -d '' -t entries < <(find . -mindepth 1 -maxdepth 1 -type d -print0)
for dir in "${entries[@]}"; do
	if [[ ! " ${FOLDERS[@]} " =~ " ${dir} " ]]; then
		clean_folder "$dir"
	fi
done
popd || exit 1

CONFIG_FOLDERS=(
	"./autostart"
	"./clampdown"
	"./cni"
	"./dconf"
	"./foot"
	"./gh"
	"./gnome-session"
	"./gtk-2.0"
	"./gtk-3.0"
	"./gtk-4.0"
	"./ibus"
	"./kanshi"
	"./nautilus"
	"./neomutt"
	"./pipewire"
	"./pulse"
	"./systemd"
	"./wireplumber"
)
pushd ~/.config || exit 127
find . -maxdepth 1 -type d -empty -delete
mapfile -d '' -t entries < <(find . -mindepth 1 -maxdepth 1 -type d -print0)
for dir in "${entries[@]}"; do
	if [[ ! " ${CONFIG_FOLDERS[@]} " =~ " ${dir} " ]]; then
		clean_folder "$dir"
	fi
done
popd || exit 1

LOCAL_FOLDERS=(
	"./bin"
	"./share"
	"./state"
	"./rust"
)
pushd ~/.local/ || exit 127
find . -maxdepth 1 -type d -empty -delete
mapfile -d '' -t entries < <(find . -mindepth 1 -maxdepth 1 -type d -print0)
for dir in "${entries[@]}"; do
	if [[ ! " ${LOCAL_FOLDERS[@]} " =~ " ${dir} " ]]; then
		clean_folder "$dir"
	fi
done
popd || exit 1

LOCAL_FOLDERS=(
	"./applications"
	"./bash-completion"
	"./clampdown"
	"./containers"
	"./flatpak"
	"./gh"
	"./gnome-settings-daemon"
	"./gnome-shell"
	"./go"
	"./system-go"
	"./gvfs-metadata"
	"./icc"
	"./icons"
	"./keyrings"
	"./man"
	"./nautilus"
	"./nix"
	"./rust"
)

pushd ~/.local/share || exit 127
find . -maxdepth 1 -type d -empty -delete
mapfile -d '' -t entries < <(find . -mindepth 1 -maxdepth 1 -type d -print0)
for dir in "${entries[@]}"; do
	if [[ ! " ${LOCAL_FOLDERS[@]} " =~ " ${dir} " ]]; then
		clean_folder "$dir"
	fi
done
popd || exit 1

FLATS="$(flatpak list --app --columns=application)"
for d in ~/.var/app/*; do
	if echo "$d" | grep -q syncthing; then
		continue
	fi
	DIR=$(basename "$d")
	if ! echo "$FLATS" | grep -q "$DIR"; then
		clean_folder "$d"
	fi
done
rm -rf "${HOME}/.var/app/org.chromium.Chromium/cache"
# find "$HOME/.var/app" -iname cache -type d -exec echo rm -rf {} +
