#!/bin/sh

sudo dnf install -y \
	https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-"$(rpm -E %fedora)".noarch.rpm \
	https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-"$(rpm -E %fedora)".noarch.rpm

sudo dnf remove \
	PackageKit* \
	abrt* \
	cockpit* \
	smartmontools* \
	rsyslog* \
	libreoffice* \
	open-vm* qemu-guest-agent virtualbox-guest-additions \
	gnome-software

##############################################################################

sudo dnf copr enable chenxiaolong/sbctl
sudo dnf install sbctl systemd-ukify systemd-devel shim-unsigned-x64

sudo tee /etc/kernel/install.conf << EOF
BOOT_ROOT=/boot/efi
layout=uki
uki_generator=ukify
initrd_generator=dracut
EOF

echo "timeout 0
default $(cat /etc/machine-id)-*" | sudo tee /boot/efi/loader/loader.conf

if sudo sbctl status | grep -q 'sbctl is not installed'; then
	sudo kernel-install -v add-all

	sudo rm -rf "/boot/efi/$(cat /etc/machine-id)" "/boot/efi/loader/entries"
	sudo ln -sf /dev/null /etc/kernel/install.d/51-dracut-rescue.install

	sudo sbctl create-keys
	sudo sbctl enroll-keys --firmware-builtin
	sudo cp /usr/share/shim/*/x64/* /boot/efi/EFI/systemd/
	sudo sbctl verify 2> /dev/null | grep ' not ' | cut -d' ' -f2 | xargs -I{} sudo sbctl sign -s {}
fi

##############################################################################

sudo dnf install \
	android-tools \
	btop \
	crun \
	curl \
	docker \
	docker-buildx \
	docker-compose \
	foot \
	foot-terminfo \
	git \
	lm_sensors \
	mosh \
	podman \
	powertop \
	runc \
	tailscale \
	tmux \
	vim

sudo usermod -aG docker "$USER"
sudo systemctl disable --now docker.service || :
sudo systemctl enable --now docker.socket
sudo systemctl enable --now powertop

##############################################################################

sudo firewall-cmd --set-default-zone=drop
sudo firewall-cmd --permanent --add-port=22/tcp
sudo firewall-cmd --permanent --add-service=mosh
# drop also blocks mDNS replies, which avahi needs to find the network printer
sudo firewall-cmd --permanent --add-service=mdns
sudo firewall-cmd --reload

# mosh-server otherwise waits forever for a client that's gone (Termux
# killed), keeping a stale tmux client attached; give up after a day
echo "SetEnv MOSH_SERVER_NETWORK_TMOUT=86400" | sudo tee /etc/ssh/sshd_config.d/50-mosh.conf > /dev/null
sudo systemctl enable --now sshd tailscaled
sudo systemctl reload sshd
tailscale status > /dev/null || sudo tailscale up
printf '%s\n' "[org/gnome/settings-daemon/plugins/power]" "sleep-inactive-ac-type='nothing'" | sudo tee /etc/dconf/db/gdm.d/95-power > /dev/null
sudo dconf update

##############################################################################

sudo systemctl disable --now thermald.service || :
if ! grep -q Intel /proc/cpuinfo; then
	sudo dnf swap tuned-ppd power-profiles-daemon
	sudo powerprofilesctl configure-action amdgpu_panel_power --enable
	sudo powerprofilesctl configure-action amdgpu_dpm --enable
	sudo powerprofilesctl set power-saver
else
	sudo dnf install -y intel-media-driver libva-*-driver intel-lpmd
	sudo mkdir -p /etc/systemd/system/intel_lpmd.service.d/
	# Snapshot the packaged Arrow Lake-H config once, so the upstream
	# default is recoverable after our override lands on top.
	sudo cp /etc/intel_lpmd/intel_lpmd_config_F6_M197.xml /etc/intel_lpmd/intel_lpmd_config_F6_M197.xml.orig || :
	sudo cp "$(dirname "$(realpath "$0")")/../../../intel-ppd/intel_lpmd_config_F6_M197.xml" /etc/intel_lpmd/
	# Companion seed for the POST-V0.1.0 UseProcessCPUSet overlay in
	# intel_lpmd_config_F6_M197.xml.
	sudo cp /etc/intel_lpmd/process_cpuset.xml /etc/intel_lpmd/process_cpuset.xml.orig || :
	sudo cp "$(dirname "$(realpath "$0")")/../../../intel-ppd/process_cpuset.xml" /etc/intel_lpmd/
	sudo cp "$(dirname "$(realpath "$0")")/../../../intel-ppd/override.conf" /etc/systemd/system/intel_lpmd.service.d/
	sudo systemctl daemon-reload
	sudo systemctl enable intel_lpmd.service
	sudo systemctl restart intel_lpmd.service
fi
