#!/usr/bin/env bash

secrets=~/.config/neomutt/secrets.gpg
current=$([ ! -f "$secrets" ] || gpg -dq "$secrets") || exit 1

out=
for account in personal work; do
	read -rsp "$account app password (empty keeps the current one): " pass
	echo
	if [ -z "$pass" ]; then
		pass=$(sed -n "s/^set my_${account}_pass = \"\(.*\)\"\$/\1/p" <<< "$current")
	fi
	if [ -n "$pass" ]; then
		out+="set my_${account}_pass = \"$pass\""$'\n'
	fi
done
printf %s "$out" | gpg -eq --default-recipient-self --yes -o "$secrets"
