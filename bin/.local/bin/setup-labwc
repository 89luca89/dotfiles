#!/usr/bin/env bash

rm -rf ~/.config/labwc
ln -sf "${HOME}/dotfiles/labwc/.config/labwc" ~/.config/labwc

mkdir -p ~/.config/systemd/user
for f in "${HOME}/dotfiles/labwc/.config/systemd/user/"*; do
	ln -sf "$f" ~/.config/systemd/user/
done

# link each file, not the directory: other programs write there too
mkdir -p ~/.local/share/applications
for f in "${HOME}/dotfiles/labwc/.local/share/applications/"*; do
	ln -sf "$f" ~/.local/share/applications/
done

sudo dnf install -y \
	xorg-x11-server-Xwayland labwc foot foot-terminfo fuzzel mako swaybg wlopm wl-clipboard brightnessctl \
	pipewire wireplumber pipewire-pulseaudio \
	xdg-user-dirs xdg-utils xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk flatpak \
	wiremix alsa-utils \
	bluez blueman nm-connection-editor NetworkManager-tui NetworkManager-openvpn \
	wdisplays wlr-randr kanshi \
	nautilus gnome-disk-utility udisks2 \
	swayidle swaylock libnotify \
	mate-polkit gnome-keyring \
	gvfs gvfs-mtp gvfs-smb \
	grim slurp \
	gsettings-desktop-schemas dconf adwaita-icon-theme adwaita-cursor-theme \
	google-noto-sans-fonts google-noto-emoji-fonts jetbrains-mono-fonts

systemctl --user daemon-reload
systemctl --user enable --now pipewire 
systemctl --user enable labwc-session.target
