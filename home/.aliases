# BASIC ALIASES
alias cp='cp --reflink=auto --sparse=always'
alias ll='ls -Ahl --group-directories-first --color'
alias tfswitch="tfswitch -b $HOME/.local/bin/terraform"
alias tree='tree -I ".git" -a'
alias mail='vim /tmp/mail.eml'
alias libvirt="DBX_CONTAINER_MANAGER=docker distrobox enter libvirt"
alias vi='vi -u ~/.vimrc-minimal'
export CARGO_HOME=$HOME/.local/rust
export GOPATH=$HOME/.local/share/go
export GOTMPDIR=$HOME/.cache/go-build
tty >/dev/null && export GPG_TTY=$(tty)
export QT_QPA_PLATFORMTHEME=gnome
export RUSTUP_HOME=$HOME/.local/share/rust
export TMUX_TMPDIR=/var/tmp
export PATH=$CARGO_HOME/bin/:$PATH
export PATH=$HOME/.local/bin:$PATH
export PATH=$HOME/.local/share/flatpak/exports/bin:$PATH
export PATH=$HOME/bin:$PATH
export PATH=$PATH:/usr/sbin:/usr/local/sbin
PATH=$(printf %s "$PATH" | awk -v RS=: '!seen[$0]++ {printf "%s%s", sep, $0; sep = ":"}')
export EDITOR=vim
export COLORTERM=truecolor

alias claude="~/Projects/Personal/clampdown/clampdown claude --gh --append-system-prompt-file ~/dotfiles/chats/AGENTS.md -- --autocompact 384k --dangerously-skip-permissions  --effort max --model 'claude-opus-4-7[1m]'"
alias claude-opus="~/Projects/Personal/clampdown/clampdown claude --gh --append-system-prompt-file ~/dotfiles/chats/AGENTS.md -- --dangerously-skip-permissions  --effort max --model claude-opus-5-5"
alias pi="~/Projects/Personal/clampdown/clampdown pi --env-file ~/.config/clampdown/clampdownrc-pi --gh --append-system-prompt-file ~/dotfiles/chats/AGENTS.md -- --model opencode-go/glm-5.3-flash --thinking max"
